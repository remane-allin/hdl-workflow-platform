# Runtime and tool outputs
**/_runtime/
**/transcript
**/*.wlf
**/*.vcd
**/*.fst
**/*.log
**/*.jou
!prj/*/output/sim/**/*.wlf
!prj/*/output/sim/**/*.vcd
**/*.pb
**/*.rpt.tmp
clockInfo.txt
*.statebak
**/.memory.lock
.Xil/
local/

# Local project instances are not published from this platform repository.
prj/*/
!prj/
!prj/README.md
!prj/.gitkeep
config/prj/*/
!config/prj/
!config/prj/README.md

# Project-local memory that should stay outside permanent history.
prj/*/work/memory/transient/**
prj/*/work/memory/**/transient/**
prj/*/_archive/memory_history/**

# Local/vendor source documents and parser extracts.
# Review source-document redistribution rights before publishing these.
prj/*/input/raw_docs/*.pdf
prj/*/work/docparse/mineru_raw/**

# Python/tool cache
__pycache__/
*.py[cod]
.pytest_cache/

# Local generated library database and large uploaded source files.
lib/local/
lib/work/
lib/files/**/*.pdf
lib/files/**/*.zip
lib/files/**/*.tar
lib/files/**/*.tar.gz
lib/files/**/*.7z
lib/files/fpga_io_tables/**/*.xlsx
lib/files/fpga_io_tables/**/*.xls
lib/files/fpga_io_tables/**/*.csv
lib/files/fpga_io_tables/**/*.tsv
lib/files/fpga_schematics/**/*.pdf
lib/files/fpga_schematics/**/*.zip
