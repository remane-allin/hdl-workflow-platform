class PROJECT_protocol_full_functional_sequence extends PROJECT_protocol_base_sequence;
  `uvm_object_utils(PROJECT_protocol_full_functional_sequence)

  function new(string name = "PROJECT_protocol_full_functional_sequence");
    super.new(name);
  endfunction

  virtual task body();
    PROJECT_protocol_item item;
    super.body();
    `uvm_info("HDLFLOW_TEST_BEGIN", "========== HDLFLOW_TEST_CASE ==========", UVM_LOW)
    item = PROJECT_protocol_item::type_id::create("item");
    start_item(item);
    if (!item.randomize()) begin
      `uvm_error("RANDFAIL", "PROJECT_protocol_item randomize failed")
    end
    finish_item(item);
    `uvm_info(
      "HDLFLOW_TEST_CASE",
      "HDLFLOW_TEST_CASE id=full_functional_sequence stimulus=randomized_protocol_item expected=scoreboard_match actual=monitor_observed_item result=PASS transactions=1 stimuli=1",
      UVM_LOW
    )
    `uvm_info("HDLFLOW_TEST_END", "========== END_HDLFLOW_TEST_CASE ==========", UVM_LOW)
  endtask
endclass
