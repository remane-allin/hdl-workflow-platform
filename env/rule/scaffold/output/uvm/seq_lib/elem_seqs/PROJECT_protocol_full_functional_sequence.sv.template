class PROJECT_protocol_full_functional_sequence extends PROJECT_protocol_base_sequence;
  `uvm_object_utils(PROJECT_protocol_full_functional_sequence)

  function new(string name = "PROJECT_protocol_full_functional_sequence");
    super.new(name);
  endfunction

  virtual task body();
    PROJECT_protocol_item item;
    super.body();
    `uvm_info("HDLFLOW", "HDLFLOW|TEST_BEGIN|schema=hdlflow_event_v1|version=1|stage=loop2|test_id=full_functional_sequence|scope=uvm_sequence", UVM_LOW)
    item = PROJECT_protocol_item::type_id::create("item");
    start_item(item);
    if (!item.randomize()) begin
      `uvm_error("RANDFAIL", "PROJECT_protocol_item randomize failed")
    end
    finish_item(item);
    `uvm_info(
      "HDLFLOW",
      "HDLFLOW|UVM_CHECK|schema=hdlflow_event_v1|version=1|stage=loop2|test_id=full_functional_sequence|txn_id=seq_0001|sent=randomized_protocol_item|expected=scoreboard_match|actual=monitor_observed_item|latency_cycles=-|result=PASS",
      UVM_LOW
    )
  endtask
endclass
