      }
    }
  ],
  "Stop": [
    {
      "type": "command",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File env\\core\\hooks\\Invoke-HdlStopCheckpoint.ps1 -WorkspaceRoot .",
