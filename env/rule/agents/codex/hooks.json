      "metadata": {
        "owner": "hdl-workflow",
        "version": "1.0.0",
        "purpose": "restore HDL workflow context"
      }
    }
  ],
  "PostToolUse": [
    {
      "type": "command",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File env\\core\\hooks\\Invoke-HdlPostToolSync.ps1 -WorkspaceRoot .",
      "metadata": {
        "owner": "hdl-workflow",
        "version": "1.0.0",
