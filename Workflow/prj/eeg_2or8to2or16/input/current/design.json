  },
  "requirements": {
    "items": [
      {
        "id": "REQ-P1-FUNC",
        "category": "functional",
        "statement": "Execute the approved EEG program and return the bit-exact classification result through the PL boundary.",
        "acceptance": "The formal whole-design case completes without protocol or result mismatch."
      },
      {
        "id": "REQ-P1-PERF",
        "category": "performance",
        "statement": "One approved EEG inference completes in no more than 33600 accelerator cycles.",
        "acceptance": "The formal TB cycle counter reports at most 33600 cycles."
      },
      {
        "id": "REQ-P1-RESOURCE",
        "category": "resource",
        "statement": "The routed accelerator and PS/PL integration fit the approved Zynq-7020 resource envelope.",
        "acceptance": "Post-route LUT, LUTRAM, FF, BRAM and DSP conditions all pass."
      },
      {
        "id": "REQ-P1-TIMING",
        "category": "timing",
        "statement": "The 70 MHz PS/PL implementation closes setup and hold timing.",
        "acceptance": "Post-route setup and hold WNS are non-negative with no DRC error or unrouted net."
      }
    ]
  },
  "architecture": {
    "items": [
      {
        "id": "ARCH-P1-DATAFLOW",
        "requirements": [
          "REQ-P1-FUNC",
          "REQ-P1-PERF",
          "REQ-P1-RESOURCE",
          "REQ-P1-TIMING"
        ],
        "blocks": [
          "PS7 AXI master",
          "AXI3-to-AXI4 adapter",
          "AXI control and sample gateway",
          "instruction scheduler",
          "feature memory",
          "shared convolution datapath",
          "argmax"
        ],
        "dataflow": "PS writes ordered parameter, instruction and time-major channel-interleaved EEG sample words; PL schedules convolution, activation, pooling and dense operations over shared arithmetic and feature storage; argmax retires one class result.",
        "control": "The PS issues one start only after all inputs are committed; ready/valid and AXI responses provide backpressure; infer_done interrupts the PS after the result is stable.",
        "storage": "Sample BRAM is dual-port PS/PL storage; parameters, instructions and features retain their existing explicit RTL ownership; no runtime source scanning or hidden memory image is allowed.",
        "reuse": "The datapath is reused across approved program descriptors rather than hard-wiring each network layer."
      }
    ]
  },
  "interfaces": {
    "items": [
      {
        "id": "IF-P1-AXI",
        "name": "S_AXI",
        "endpoints": [
          "processing_system7_0/M_AXI_GP0",
          "eeg_bci_ps_axi4_gateway/S_AXI"
        ],
        "direction": "PS-to-PL commands and bidirectional responses",
        "width": 32,
        "protocol": "AXI4",
        "clock": "clk_fpga_0",
        "reset": "active-low peripheral_aresetn",
        "ordering": "AXI order",
        "lifecycle": "load then start then read result"
      },
      {
        "id": "IF-P1-RESULT",
        "name": "classification result",
        "endpoints": [
          "argmax_output",
          "PS interrupt/readback"
        ],
        "direction": "PL-to-PS",
        "width": 32,
        "protocol": "stable result plus infer_done",
        "clock": "clk_fpga_0",
        "reset": "active-low",
        "ordering": "one result per accepted start",
        "lifecycle": "valid until next accepted command"
      }
    ]
  },
