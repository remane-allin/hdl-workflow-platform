    "project_id": "eeg_ssvep_2to16",
    "display_name": "Instruction-configured shared EEG and SSVEP accelerator",
    "platform": "navigator_zynq_7020",
    "part": "xc7z020clg400-1",
    "rtl_language": "Verilog-2001",
    "tool_profile": "xilinx-2024.2"
  },
  "requirements": {
    "items": [
      {
        "id": "REQ-P2-EEG",
        "category": "functional",
        "statement": "Execute the approved EEG program on the shared engine and return sixteen bit-exact logits.",
        "acceptance": "The formal whole-design EEG case completes with all logits and protocol checks passing."
      },
      {
        "id": "REQ-P2-SSVEP",
        "category": "functional",
        "statement": "Execute the approved SSVEP program on the same mutually exclusive shared engine.",
        "acceptance": "All one hundred formal SSVEP trials return bit-exact logits and predictions."
      },
      {
        "id": "REQ-P2-PERF",
        "category": "performance",
        "statement": "Every approved SSVEP trial completes in no more than 20000 accelerator cycles.",
        "acceptance": "The maximum accepted-start to done interval reported by the formal TB is at most 20000 cycles."
      },
      {
        "id": "REQ-P2-RESOURCE",
        "category": "resource",
        "statement": "The routed shared accelerator fits the approved Zynq-7020 OOC resource envelope.",
        "acceptance": "Post-route LUT, FF, RAMB36, RAMB18 and DSP conditions all pass."
      },
      {
        "id": "REQ-P2-TIMING",
        "category": "timing",
        "statement": "The OOC accelerator closes the 70 MHz implementation with more than 0.300 ns setup slack.",
        "acceptance": "Post-route timing, route status and DRC conditions all pass."
      },
      {
        "id": "REQ-P2-REUSE",
        "category": "architecture",
        "statement": "EEG and SSVEP use program and parameter images over one compute, memory and retire fabric rather than parallel mode-specific pipelines.",
        "acceptance": "Both formal modes pass through the same shared_bci_accel_top hierarchy and the routed design contains the approved six memory macros."
      }
    ]
  },
  "architecture": {
    "items": [
      {
        "id": "ARCH-P2-SHARED",
        "requirements": [
          "REQ-P2-EEG",
          "REQ-P2-SSVEP",
          "REQ-P2-PERF",
          "REQ-P2-RESOURCE",
          "REQ-P2-TIMING",
          "REQ-P2-REUSE"
        ],
        "blocks": [
          "AXI control loader",
          "program and descriptor controller",
          "shared kernel step sequencer",
          "shared operand and address services",
          "six native block memories",
          "sixteen-lane FP16 APX cluster",
          "unified retire"
        ],
        "dataflow": "A 64-bit AXI-facing loader accepts one selected mode program, parameters and time-major frame. Registered descriptors sequence shared memory operands through the APX cluster and unified retire path. EEG and SSVEP are separate runs and never execute concurrently. Triangular scratch rows preload into the existing scalar bank before retirement. APX issue latency remains unchanged; source and modifier controls are registered as four local quadrant copies so each copy drives only four arithmetic lanes.",
        "control": "Program descriptors select convolution, pooling, covariance, whitening, projection, energy and classification primitives. Ready/valid boundaries provide backpressure and one done closes each accepted start. The window issue FSM observes registered return-active state instead of a same-cycle return comparator. APX operand selection is structurally partitioned into four 64-bit quadrants while preserving the proven dispatch-to-arithmetic timing.",
        "storage": "Program and parameter stores are 64x512 simple dual-port BRAMs. Four feature banks are 16x2048 true dual-port BRAMs. The native Vivado XCI files are the sole IP configuration authority. Existing collision-only APX pending operands remain unchanged; only compact quadrant control registers are replicated.",
        "reuse": "A future signal mode is added with reviewed program, parameter and profile images when current primitives suffice; a missing generic primitive requires an architecture review rather than a mode-specific pipeline."
      }
    ]
  },
  "interfaces": {
    "items": [
      {
        "id": "IF-P2-AXI",
        "name": "S_AXI",
        "endpoints": [
          "PS or verification master",
          "axi_control_loader"
        ],
        "direction": "configuration, program, parameter and frame writes plus result reads",
        "width": 64,
        "protocol": "AXI4-Lite style independent channels",
        "clock": "clk",
        "reset": "active-low reset_n",
        "ordering": "program and parameters before frame and start",
        "lifecycle": "one mutually exclusive mode per accepted start"
      },
      {
        "id": "IF-P2-DESCRIPTOR",
        "name": "descriptor execution boundary",
        "endpoints": [
          "descriptor_controller",
          "descriptor_execution_engine"
        ],
        "direction": "command, operand request and completion",
        "width": 128,
        "protocol": "registered ready/valid descriptors",
        "clock": "clk",
        "reset": "active-low reset_n",
        "ordering": "program-counter order",
        "lifecycle": "issue, execute, retire, advance"
      },
      {
        "id": "IF-P2-RESULT",
        "name": "classification stream",
        "endpoints": [
          "unified_retire",
          "axi_control_loader"
        ],
        "direction": "PL-to-consumer",
        "width": 16,
        "protocol": "ready/valid with result_last",
        "clock": "clk",
        "reset": "active-low reset_n",
        "ordering": "class index order",
        "lifecycle": "terminates exactly once before done"
      }
    ]
  },
